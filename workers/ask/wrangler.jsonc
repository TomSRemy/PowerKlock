// « Ask PowerKlock »: the Worker behind News › Ask (index.js). Deployed on its own (Workers Builds, root directory
// workers/ask). Workers AI is the free plan's (10,000 neurons a day, shared with the newsletter).
// SUPABASE_KEY is the site's publishable key (public, already in js/account.js): the database's own rules decide.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "powerklock-ask",
  "main": "index.js",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // Cloudflare builds branches other than the production one with `wrangler preview`, which needs this block, even empty
  "previews": {},
  "vars": {
    "SUPABASE_URL": "https://xtqeslyjtjrbjpffpixn.supabase.co",
    "SUPABASE_KEY": "sb_publishable_mfgTs1zA6ZT69hU0DhXpnA_YmjpkRQ1",
    "SITE": "https://www.powerklock.com"
  }
}
