# Cloudflare Worker static assets: the browser checks the page, its scripts, styles and translations on every
# visit (a 304 when nothing changed), so a new version never mixes with old cached files.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/landing.html
  Cache-Control: no-cache
/data/landing.json
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/assets/*.json
  Cache-Control: no-cache
/data/agenda.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: max-age=3600
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Cache-Control: no-cache
