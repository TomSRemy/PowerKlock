# Cloudflare Worker static assets: the browser checks the page, its scripts, styles and translations on every
# visit (a 304 when nothing changed), so a new version never mixes with old cached files.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/assets/*.json
  Cache-Control: no-cache
