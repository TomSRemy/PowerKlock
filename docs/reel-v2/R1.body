<style>
#cv{left:0;top:0}
#num{left:65px;top:520px;transform-origin:0 0;white-space:nowrap;color:var(--rise);font:800 340px/1 var(--mono);letter-spacing:-.04em}
#num small{font:700 64px/1 var(--mono);letter-spacing:0;color:var(--text2);margin-left:18px}
#sub{left:65px;top:910px;width:885px}
#sub b{display:block;font:800 92px/1.05 var(--sans);letter-spacing:-.02em}
#sub span{display:block;margin-top:26px;font:600 46px/1.2 var(--sans);color:var(--text2)}
#tag{left:65px;top:496px;width:885px;font:600 38px/1.2 var(--sans);color:var(--text2)}
#end{left:65px;top:1220px;width:885px;display:flex;align-items:center;gap:34px}
#end b{font:800 150px/1 var(--mono);color:var(--mark);letter-spacing:-.04em}
#end span{font:600 40px/1.2 var(--sans);color:var(--text)}
#end span em{font-style:normal;color:var(--text3);display:block;font:500 30px/1.3 var(--mono);margin-top:10px}
</style>
<canvas id="cv" width="1080" height="1920"></canvas>
<div class="kick" id="kick"></div><div id="num"></div><div id="sub"></div><div id="tag"></div><div id="end"></div>
<script>
__COMMON__
__DUO__
const PY = (D.y.q || []).map((v, i) => [gx(i), gy(v)]);
$('kick').textContent = T('La courbe du jour · ', 'The day’s curve · ') + dLong(D.d);
$('num').innerHTML = fmt(D.max, 0) + '<small>€/MWh</small>';
const since = D.sinceMax[1] ? T('plus haut depuis le ' + dShort(D.sinceMax[1]), 'highest since ' + dShort(D.sinceMax[1])) : T('record de la période', 'a record');
$('sub').innerHTML = '<b>' + T('ce matin à ' + hm(iMax), 'this morning at ' + hm(iMax)) + '</b><span>' + T('Le quart d’heure le ', 'The quarter-hour: ') + since + '</span>';
$('tag').textContent = T('à ' + hm(iMax) + ' · ', 'at ' + hm(iMax) + ' · ') + since;
$('end').innerHTML = '<b>×' + fmt(D.max / D.min, 1) + '</b><span>' + T('entre le creux et la pointe du même jour', 'between the low and the peak of the same day') + '<em>' + fmt(D.min, 0) + ' € ' + T('à ', 'at ') + hm(iMin) + ' → ' + fmt(D.max, 0) + ' € ' + T('à ', 'at ') + hm(iMax) + '</em></span>';
// 12 s: hook 0-2.2, the day draws itself 3.2-7, punchline 7.4-9.5, the line breaks into its 96 dots 9.3-10.2,
// they leave for the next reel 10.2-11.8 while the figure comes back: the last frame is the first
const TX = 10200; window.PK_TX = TX;
const dots = t => HOME.map((h, i) => { const p = t < TX ? 0 : flight(i, t - TX); return [h[0] + DIRV[0] * p, h[1] + DIRV[1] * p, RAD[i] * eo(seg(t, 9300 + i * 6, 9600 + i * 6))]; });
window.PK_DOTS = dots;
loop(12000, t => {
  const big = t < 6000 ? 1 - io(seg(t, 2200, 2900)) : io(seg(t, 10700, 11600));
  $('num').style.transform = 'translateY(' + (-190 * (1 - big)) + 'px) scale(' + (.40 + .60 * big) * (big > .99 ? 1 + .012 * Math.sin(t / 1500 * Math.PI * 2) : 1) + ')';
  $('sub').style.opacity = t < 6000 ? 1 - seg(t, 2100, 2500) : seg(t, 11400, 11800);
  $('tag').style.opacity = seg(t, 2700, 3200) * (1 - seg(t, 10000, 10500));
  const e = eo(seg(t, 7400, 7900)) * (1 - seg(t, 9300, 9700));
  $('end').style.opacity = e; $('end').style.transform = 'translateY(' + (30 * (1 - e)) + 'px)';
  g.clearRect(0, 0, 1080, 1920);
  const b = seg(t, 2700, 3200) * (1 - seg(t, 9500, 10100)), f = io(seg(t, 3200, 7000)), la = 1 - seg(t, 9400, 10000);
  if (b > 0) {
    poly([[GX0, GY1], [GX1, GY1]], K.line, 2, b);
    [0, 24, 48, 72, 95].forEach((i, k) => txt(k === 4 ? (EN ? '24:00' : '24' + NB + 'h') : hm(i), gx(i), GY1 + 50, 28, K.text3, k === 0 ? 'left' : k === 4 ? 'right' : 'center', 500, b));
    poly(PY, K.text3, 3, b * .9, [4, 9]); if (PY.length) txt(T('hier', 'yesterday'), GX0 + 6, PY[0][1] + 44, 28, K.text3, 'left', 500, b);
    const av = seg(t, 7000, 7400) * b; poly([[GX0, gy(D.avg)], [GX1, gy(D.avg)]], K.text2, 2, av, [14, 10]); txt(T('moy. ', 'avg ') + fmt(D.avg, 0) + ' €', GX0, gy(D.avg) - 14, 28, K.text2, 'left', 500, av);
  }
  if (f > 0 && la > 0) { const c = cut(HOME, f); poly(c.P, K.text, 6, la); if (f < 1) disc(c.P[c.P.length - 1][0], c.P[c.P.length - 1][1], 11, K.text, 1); }
  if (f * 95 >= iMax) { const ph = (t % 1500) / 1500; ringc(HOME[iMax][0], HOME[iMax][1], 22 + 22 * ph, K.rise, 4, (1 - ph) * b); disc(HOME[iMax][0], HOME[iMax][1], 14, K.rise, la);
    txt(fmt(D.max, 0) + ' €', HOME[iMax][0] + 34, HOME[iMax][1] + 6, 46, K.rise, 'left', 800, b); }
  if (f >= 1) { disc(HOME[iMin][0], HOME[iMin][1], 14, K.fall, la * b); txt(fmt(D.min, 0) + ' €', HOME[iMin][0] - 26, HOME[iMin][1] + 16, 40, K.fall, 'right', 800, b); }
  if (t >= 9300) dots(t).forEach((d, i) => disc(d[0], d[1], d[2], COL[i], 1));
});
</script>
